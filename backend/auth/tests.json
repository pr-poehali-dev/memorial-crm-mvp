{
  "tests": [
    {
      "name": "Get company by slug returns 200",
      "method": "GET",
      "path": "/?section=slug_entry&slug=company-2",
      "expectedStatus": 200
    },
    {
      "name": "Unknown slug returns 404",
      "method": "GET",
      "path": "/?section=slug_entry&slug=nonexistent-xyz",
      "expectedStatus": 404
    },
    {
      "name": "Admin companies list returns 200",
      "method": "GET",
      "path": "/?section=admin_companies",
      "expectedStatus": 200
    }
  ]
}